                {
                  "type": "text",
                  "id": "HOyK2",
                  "name": "pbCode1",
                  "fill": "#9254DE",
                  "content": "1   from typing import Dict, Any",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Vrxho",
                  "name": "pbCode2",
                  "fill": "#666666",
                  "content": "2",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "oPgfS",
                  "name": "pbCode3",
                  "fill": "#1890FF",
                  "content": "3   def calculate_gear(teeth: int, module: float) -> Dict[str, Any]:",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "DKDuv",
                  "name": "pbCode4",
                  "fill": "#52C41A",
                  "content": "4       \"\"\"计算齿轮参数\"\"\"",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "SrEJx",
                  "name": "pbCode5",
                  "fill": "#E6E6E6",
                  "content": "5       pitch_diameter = teeth * module",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "NAUR1",
                  "name": "pbCode6",
                  "fill": "#E6E6E6",
                  "content": "6       addendum = 1.0 * module",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "4JsH3",
                  "name": "pbCode7",
                  "fill": "#E6E6E6",
                  "content": "7       dedendum = 1.25 * module",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "I3ApK",
                  "name": "pbCode8",
                  "fill": "#666666",
                  "content": "8        ",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "6iGS0",
                  "name": "pbCode9",
                  "fill": "#E6E6E6",
                  "content": "9       return {",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "2ZszL",
                  "name": "pbCode10",
                  "fill": "#E6E6E6",
                  "content": "10          'teeth': teeth,",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
